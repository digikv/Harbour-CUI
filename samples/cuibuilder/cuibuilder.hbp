# CuiBuilder - builds Harbour programs and libraries (Harbour-CUI)
# build.bat (Windows) / build.sh (Linux) build the library first when it is missing.
#   hbmk2 cuibuilder.hbp
# The editor (F4, errors) is the one of CEdit (../cedit). cuibuilder.hwprj
# builds the same with CuiBuilder itself.

-w3 -es2
-ocuibuilder
-i../cedit

../../hbtui.hbc

cuibuilder.prg
cbengine.prg
cbrepdes.prg
cbformdes.prg
../shared/cbreport.prg
{win}cbwin.c
../cedit/htcodeedit.prg
../cedit/cebuffer.prg
../cedit/cesyntax.prg

# the report designer: the DOCX / XLSX classes (github.com/digikv/docx, /xlsx)
# next to the Harbour-CUI folder; without them it cannot try a report in Word / Excel
{hb_ispath='../../../docx/DOCXClass.prg'}../../../docx/DOCXClass.prg
{!hb_ispath='../../../docx/DOCXClass.prg'}-prgflag=-DCBR_NO_DOCX
{hb_ispath='../../../xlsx/XLSXClass.prg'}../../../xlsx/XLSXClass.prg
{!hb_ispath='../../../xlsx/XLSXClass.prg'}-prgflag=-DCBR_NO_XLSX
hbziparc.hbc

{unix}-lX11
