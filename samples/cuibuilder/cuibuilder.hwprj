# CuiBuilder built by itself:  cuibuilder cuibuilder.hwprj  (F9), or  cuibc cuibuilder.hwprj
# (the same as cuibuilder.hbp for hbmk2). The Harbour-CUI library comes from
# [GUILIB] of cuibuild.ini.

outname=cuibuilder
incpath=../cedit
prgflags=-w3 -es2
cuibuilder.prg
cbengine.prg
cbrepdes.prg
cbformdes.prg
../shared/cbreport.prg
hbziparc.hbc
{hb_ispath='../../../docx/DOCXClass.prg'}../../../docx/DOCXClass.prg
{!hb_ispath='../../../docx/DOCXClass.prg'}prgflags=-DCBR_NO_DOCX
{hb_ispath='../../../xlsx/XLSXClass.prg'}../../../xlsx/XLSXClass.prg
{!hb_ispath='../../../xlsx/XLSXClass.prg'}prgflags=-DCBR_NO_XLSX
../cedit/htcodeedit.prg
../cedit/cebuffer.prg
../cedit/cesyntax.prg
{win}cbwin.c
