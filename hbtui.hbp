#
#
#

# debug info (the Harbour debugger, Alt-D) only on request:
#   hbmk2 hbtui.hbp -env:HBTUI_DEBUG=yes  - else every program carried the
#   debugger and Alt-D opened it
{HBTUI_DEBUG}-b
-w3 -es2 -gc3
-hblib
-inc
-olib/${hb_plat}/${hb_comp}/hbtui

-iinclude

src/*.c
src/*.prg
src/HTWindow/*.c
src/HTWindow/*.prg
src/HTEvent/*.prg
src/HTEvent/HTInputEvent/*.prg
src/HTWidget/*.prg
src/HTWidget/HTAbstractButton/*.prg
src/types/*.prg

$hb_pkg_dynlib.hbm
